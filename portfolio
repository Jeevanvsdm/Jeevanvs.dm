<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jeevan VS | Digital Marketing Executive & SEO Specialist</title>
  <meta name="description" content="Jeevan VS is a Digital Marketing Executive and SEO Specialist offering SEO, paid advertising, social media marketing, content creation, analytics, and email marketing." />
  <meta name="theme-color" content="#0B1120" />
  <link rel="canonical" href="https://YOUR-USERNAME.github.io/" />

  <!-- Open Graph / Twitter -->
  <meta property="og:title" content="Jeevan VS | Digital Marketing Executive & SEO Specialist" />
  <meta property="og:description" content="Creative strategies. Smarter campaigns. Measurable growth." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://YOUR-USERNAME.github.io/" />
  <meta name="twitter:card" content="summary" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg: #0B1120;
      --bg-2: #111827;
      --primary: #4F46E5;
      --secondary: #7C3AED;
      --accent: #06B6D4;
      --white: #FFFFFF;
      --muted: #94A3B8;
      --glass: rgba(255, 255, 255, 0.06);
      --border: rgba(255, 255, 255, 0.12);
      --radius: 18px;
      --shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; scroll-padding-top: 90px; }
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--white);
      line-height: 1.6;
      overflow-x: hidden;
    }
    img, svg { max-width: 100%; display: block; }
    a { color: inherit; text-decoration: none; }
    section { padding: clamp(70px, 9vw, 120px) 0; position: relative; }
    .container { width: min(1200px, 92%); margin: 0 auto; }

    h1, h2, h3 { line-height: 1.15; letter-spacing: -0.02em; }
    h1 { font-size: clamp(2.6rem, 6vw, 4.6rem); font-weight: 800; }
    h2 { font-size: clamp(1.9rem, 4vw, 2.9rem); font-weight: 700; }
    h3 { font-size: 1.2rem; font-weight: 600; }
    p { color: var(--muted); }
    .gradient-text {
      background: linear-gradient(120deg, var(--primary), var(--accent));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .eyebrow {
      font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.15em;
      color: var(--accent); font-weight: 600; margin-bottom: 0.8rem; display: block;
    }
    .section-head { max-width: 680px; margin-bottom: 3.5rem; }
    .section-head p { margin-top: 1rem; font-size: 1.05rem; }

    /* Focus */
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 6px; }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
      padding: 0.85rem 1.6rem; border-radius: 999px; font-weight: 600; font-size: 0.95rem;
      border: 1px solid transparent; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
      font-family: inherit;
    }
    .btn:hover { transform: translateY(-2px); }
    .btn-primary {
      background: linear-gradient(120deg, var(--primary), var(--secondary));
      color: var(--white); box-shadow: 0 10px 30px rgba(79, 70, 229, 0.35);
    }
    .btn-secondary { background: var(--glass); border-color: var(--border); color: var(--white); }
    .btn-secondary:hover { background: rgba(255,255,255,0.12); }
    .btn-ghost { background: transparent; color: var(--accent); }
    .btn-ghost:hover { text-decoration: underline; }
    .btn-small { padding: 0.55rem 1.1rem; font-size: 0.85rem; }

    /* Glass cards */
    .glass {
      background: var(--glass); border: 1px solid var(--border);
      border-radius: var(--radius); backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px); box-shadow: var(--shadow);
      transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s;
    }
    .glass:hover { transform: translateY(-4px); border-color: rgba(6, 182, 212, 0.4); }

    /* Aurora background */
    .aurora {
      position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden;
    }
    .aurora::before, .aurora::after {
      content: ''; position: absolute; width: 55vw; height: 55vw; border-radius: 50%;
      filter: blur(120px); opacity: 0.25;
    }
    .aurora::before { background: var(--primary); top: -15%; left: -10%; animation: drift 18s ease-in-out infinite alternate; }
    .aurora::after { background: var(--accent); bottom: -20%; right: -10%; opacity: 0.18; animation: drift 22s ease-in-out infinite alternate-reverse; }
    @keyframes drift { to { transform: translate(60px, 40px) scale(1.1); } }

    /* Navbar */
    header {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      transition: background 0.3s, padding 0.3s, box-shadow 0.3s;
      padding: 1.2rem 0;
    }
    header.scrolled {
      background: rgba(11, 17, 32, 0.75); backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px); padding: 0.7rem 0;
      border-bottom: 1px solid var(--border);
    }
    .nav { display: flex; align-items: center; justify-content: space-between; }
    .logo { font-weight: 800; font-size: 1.2rem; letter-spacing: -0.02em; }
    .logo span { color: var(--accent); }
    .nav-links { display: flex; gap: 1.6rem; list-style: none; }
    .nav-links a {
      font-size: 0.9rem; color: var(--muted); position: relative; padding: 0.3rem 0;
      transition: color 0.2s;
    }
    .nav-links a::after {
      content: ''; position: absolute; left: 0; bottom: -2px; height: 2px; width: 0;
      background: linear-gradient(90deg, var(--primary), var(--accent));
      transition: width 0.3s;
    }
    .nav-links a:hover, .nav-links a.active { color: var(--white); }
    .nav-links a:hover::after, .nav-links a.active::after { width: 100%; }
    .menu-toggle {
      display: none; background: none; border: none; cursor: pointer; width: 42px; height: 42px;
      position: relative; color: var(--white);
    }
    .menu-toggle span {
      position: absolute; left: 10px; right: 10px; height: 2px; background: currentColor;
      border-radius: 2px; transition: transform 0.3s, opacity 0.3s, top 0.3s;
    }
    .menu-toggle span:nth-child(1) { top: 14px; }
    .menu-toggle span:nth-child(2) { top: 21px; }
    .menu-toggle span:nth-child(3) { top: 28px; }
    .menu-toggle[aria-expanded="true"] span:nth-child(1) { top: 21px; transform: rotate(45deg); }
    .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    .menu-toggle[aria-expanded="true"] span:nth-child(3) { top: 21px; transform: rotate(-45deg); }

    @media (max-width: 1080px) {
      .menu-toggle { display: block; }
      .nav-links {
        position: fixed; top: 0; right: 0; height: 100vh; width: min(300px, 80%);
        flex-direction: column; padding: 6rem 2rem; gap: 1.4rem;
        background: rgba(11, 17, 32, 0.96); backdrop-filter: blur(20px);
        border-left: 1px solid var(--border);
        transform: translateX(100%); transition: transform 0.4s ease;
      }
      .nav-links.open { transform: translateX(0); }
      .nav-links a { font-size: 1.05rem; }
    }

    /* Hero */
    .hero { min-height: 100vh; display: flex; align-items: center; padding-top: 120px; }
    .hero-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 4rem; align-items: center; }
    .badge {
      display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.45rem 1rem;
      border-radius: 999px; background: var(--glass); border: 1px solid var(--border);
      font-size: 0.82rem; color: var(--muted); margin-bottom: 1.5rem;
    }
    .badge .dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 10px #22c55e; }
    .hero h1 { margin-bottom: 0.8rem; }
    .typed-wrap { font-size: clamp(1.2rem, 2.4vw, 1.6rem); font-weight: 600; min-height: 2.2rem; margin-bottom: 1.4rem; }
    #role { transition: opacity 0.35s, transform 0.35s; display: inline-block; }
    #role.swap { opacity: 0; transform: translateY(8px); }
    .hero .bio { font-size: 1.08rem; max-width: 560px; margin-bottom: 0.8rem; }
    .hero .tagline { color: var(--white); font-weight: 600; margin-bottom: 2.2rem; }
    .cta-row { display: flex; flex-wrap: wrap; gap: 0.9rem; }

    /* Dashboard */
    .dash { position: relative; padding: 1.4rem; }
    .dash-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .dash-head strong { font-size: 0.95rem; }
    .illustrative {
      font-size: 0.7rem; color: var(--muted); border: 1px dashed var(--border);
      padding: 0.2rem 0.6rem; border-radius: 999px;
    }
    .metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; margin-bottom: 1rem; }
    .metric { background: rgba(255,255,255,0.04); border: 1px solid var(--border); border-radius: 14px; padding: 0.9rem; }
    .metric small { color: var(--muted); font-size: 0.7rem; }
    .metric b { display: block; font-size: 1.25rem; margin-top: 0.2rem; }
    .metric em { font-style: normal; font-size: 0.72rem; color: #22c55e; }
    .chart { display: flex; align-items: flex-end; gap: 8px; height: 130px; padding: 0.5rem 0.2rem; }
    .chart .bar {
      flex: 1; border-radius: 6px 6px 2px 2px;
      background: linear-gradient(180deg, var(--accent), var(--primary));
      height: 0; transition: height 1.2s cubic-bezier(.2,.8,.2,1);
    }
    .dash.in .bar { height: var(--h); }
    .kw-list { margin-top: 1rem; display: grid; gap: 0.5rem; }
    .kw {
      display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--muted);
      background: rgba(255,255,255,0.03); padding: 0.5rem 0.8rem; border-radius: 10px;
    }
    .kw b { color: var(--white); }
    .float-icon {
      position: absolute; width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center;
      background: var(--bg-2); border: 1px solid var(--border); box-shadow: var(--shadow);
      font-size: 0.7rem; font-weight: 700; color: var(--accent); animation: float 5s ease-in-out infinite;
    }
    .float-icon.a { top: -18px; right: 10%; }
    .float-icon.b { bottom: 20px; left: -22px; animation-delay: 1.5s; color: var(--secondary); }
    .float-icon.c { bottom: -20px; right: 22%; animation-delay: 3s; color: var(--primary); }
    @keyframes float { 50% { transform: translateY(-12px); } }

    /* About */
    .about-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 4rem; align-items: start; }
    .about-grid h2 { margin-bottom: 1.2rem; }
    .about-grid p { margin-bottom: 1rem; }
    .checklist { list-style: none; margin: 1.5rem 0; display: grid; gap: 0.7rem; }
    .checklist li { color: var(--muted); padding-left: 1.6rem; position: relative; }
    .checklist li::before {
      content: ''; position: absolute; left: 0; top: 0.5em; width: 8px; height: 8px; border-radius: 50%;
      background: linear-gradient(135deg, var(--primary), var(--accent));
    }
    .pills { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
    .pill {
      font-size: 0.8rem; padding: 0.4rem 0.9rem; border-radius: 999px;
      background: var(--glass); border: 1px solid var(--border); color: var(--muted);
    }
    .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .stat { padding: 1.6rem; }
    .stat .num { font-size: 2.4rem; font-weight: 800; }
    .stat p { font-size: 0.9rem; margin-top: 0.3rem; }

    /* Services */
    .cards-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
    .service { padding: 2rem; display: flex; flex-direction: column; }
    .icon-box {
      width: 52px; height: 52px; border-radius: 14px; display: grid; place-items: center; margin-bottom: 1.2rem;
      background: linear-gradient(135deg, rgba(79,70,229,0.3), rgba(6,182,212,0.3));
      border: 1px solid var(--border); font-size: 1.4rem;
    }
    .service p { font-size: 0.93rem; margin-bottom: 1.2rem; flex: 1; }
    .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1.2rem; }
    .tag { font-size: 0.72rem; padding: 0.25rem 0.6rem; border-radius: 6px; background: rgba(6,182,212,0.1); color: var(--accent); }
    .link-btn {
      background: none; border: none; color: var(--accent); font-weight: 600; cursor: pointer;
      font-family: inherit; font-size: 0.92rem; text-align: left; padding: 0;
    }
    .link-btn:hover { text-decoration: underline; }

    /* Why */
    .why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
    .why { padding: 1.8rem; }
    .why p { font-size: 0.93rem; }
    .why .n { font-size: 0.75rem; color: var(--accent); font-family: 'Fira Code', monospace; }
    .why h3 { margin: 0.5rem 0 0.6rem; }

    /* Knowledge */
    .know-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; margin-bottom: 3rem; }
    .know-card { padding: 1.5rem; }
    .know-card h3 { margin-bottom: 0.9rem; font-size: 1.05rem; }
    .know-card ul { list-style: none; display: grid; gap: 0.45rem; }
    .know-card li { font-size: 0.9rem; color: var(--muted); padding: 0.35rem 0.6rem; border-radius: 8px; transition: background 0.2s, color 0.2s; }
    .know-card li:hover { background: rgba(255,255,255,0.05); color: var(--white); }
    .subhead { font-size: 1.3rem; margin: 2.5rem 0 1.2rem; }
    .tool-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.9rem; }
    .tool { padding: 1rem 1.1rem; display: flex; align-items: center; gap: 0.8rem; font-size: 0.92rem; font-weight: 500; }
    .tool small { display: block; color: var(--muted); font-size: 0.72rem; font-weight: 400; }
    .cert-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.9rem; }
    .cert { padding: 1rem 1.2rem; font-size: 0.92rem; display: flex; gap: 0.7rem; align-items: center; }
    .cert::before { content: '✓'; color: var(--accent); font-weight: 700; }

    /* Experience */
    .timeline { position: relative; max-width: 820px; margin: 0 auto; padding-left: 2rem; }
    .timeline::before {
      content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--border);
    }
    .timeline-progress {
      position: absolute; left: 0; top: 0; width: 2px; height: 0;
      background: linear-gradient(180deg, var(--primary), var(--accent));
      transition: height 0.4s linear;
    }
    .job { position: relative; margin-bottom: 2.5rem; padding: 2rem; }
    .job::before {
      content: ''; position: absolute; left: calc(-2rem - 7px); top: 2.4rem; width: 14px; height: 14px;
      border-radius: 50%; background: var(--bg); border: 2px solid var(--accent);
      box-shadow: 0 0 12px var(--accent);
    }
    .job .period { font-size: 0.82rem; color: var(--accent); font-weight: 600; }
    .job h3 { margin: 0.4rem 0 0.2rem; font-size: 1.3rem; }
    .job .company { color: var(--white); font-weight: 500; font-size: 0.95rem; margin-bottom: 1rem; }
    .job ul { list-style: none; display: grid; gap: 0.5rem; margin-bottom: 1rem; }
    .job li { font-size: 0.92rem; color: var(--muted); padding-left: 1.2rem; position: relative; }
    .job li::before { content: '→'; position: absolute; left: 0; color: var(--accent); }
    .job .tools-used { display: flex; flex-wrap: wrap; gap: 0.4rem; }

    /* Projects */
    .projects-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
    .project { padding: 1.6rem; display: flex; flex-direction: column; position: relative; overflow: hidden; }
    .project::before {
      content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
      background: linear-gradient(135deg, transparent 40%, rgba(124,58,237,0.6), rgba(6,182,212,0.6));
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor; mask-composite: exclude; opacity: 0; transition: opacity 0.3s;
    }
    .project:hover::before, .project:focus-within::before { opacity: 1; }
    .project-visual {
      height: 120px; border-radius: 12px; margin-bottom: 1.2rem; background: rgba(255,255,255,0.03);
      border: 1px solid var(--border); display: grid; place-items: center; font-size: 2.2rem;
    }
    .project .num { font-family: 'Fira Code', monospace; font-size: 0.75rem; color: var(--accent); }
    .project h3 { margin: 0.4rem 0 0.6rem; }
    .project p { font-size: 0.9rem; margin-bottom: 1rem; flex: 1; }
    .project details { font-size: 0.85rem; color: var(--muted); margin-top: auto; }
    .project summary { cursor: pointer; color: var(--accent); font-weight: 600; list-style: none; }
    .project summary::-webkit-details-marker { display: none; }
    .project details ul { margin-top: 0.6rem; padding-left: 1.1rem; }
    .project details li { margin-bottom: 0.3rem; }

    /* Contact */
    .contact-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.5rem; align-items: start; }
    form { padding: 2.2rem; display: grid; gap: 1.1rem; }
    .field { display: flex; flex-direction: column; gap: 0.4rem; }
    .field label { font-size: 0.88rem; font-weight: 500; }
    .field label .req { color: var(--accent); }
    .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
    input, select, textarea {
      font-family: inherit; font-size: 0.95rem; color: var(--white);
      background: rgba(11,17,32,0.7); border: 1px solid var(--border); border-radius: 12px;
      padding: 0.85rem 1rem; transition: border-color 0.2s, box-shadow 0.2s; width: 100%;
    }
    select option { background: var(--bg-2); }
    textarea { resize: vertical; min-height: 130px; }
    input:focus, select:focus, textarea:focus {
      outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px rgba(6,182,212,0.15);
    }
    input[aria-invalid="true"], textarea[aria-invalid="true"] { border-color: #f87171; }
    .error-msg { color: #fca5a5; font-size: 0.8rem; min-height: 1em; }
    .hp { position: absolute; left: -9999px; opacity: 0; height: 0; width: 0; }
    .form-status { font-size: 0.92rem; min-height: 1.4em; }
    .form-status.ok { color: #4ade80; }
    .form-status.err { color: #fca5a5; }
    .contact-card { padding: 2rem; display: grid; gap: 1.4rem; }
    .contact-item { display: flex; gap: 1rem; align-items: center; }
    .contact-item .icon-box { margin: 0; width: 46px; height: 46px; font-size: 1.1rem; }
    .contact-item small { display: block; color: var(--muted); font-size: 0.75rem; }
    .contact-item a { font-weight: 600; }
    .contact-item a:hover { color: var(--accent); }

    /* FAQ */
    .faq-wrap { max-width: 820px; margin: 0 auto; display: grid; gap: 0.9rem; }
    .faq-item { padding: 0; overflow: hidden; }
    .faq-item summary {
      list-style: none; cursor: pointer; padding: 1.3rem 1.5rem; font-weight: 600; font-size: 1rem;
      display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after {
      content: '+'; font-size: 1.4rem; color: var(--accent); transition: transform 0.3s; flex-shrink: 0;
    }
    .faq-item[open] summary::after { transform: rotate(45deg); }
    .faq-item .answer { padding: 0 1.5rem 1.4rem; color: var(--muted); font-size: 0.95rem; }

    /* Footer */
    footer {
      border-top: 1px solid var(--border); padding: 4rem 0 2rem;
      background: linear-gradient(180deg, transparent, rgba(79,70,229,0.06));
    }
    .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 3rem; margin-bottom: 3rem; }
    .foot-grid h4 { font-size: 0.9rem; margin-bottom: 1rem; }
    .foot-grid ul { list-style: none; display: grid; gap: 0.5rem; }
    .foot-grid a, .foot-grid p { font-size: 0.9rem; color: var(--muted); }
    .foot-grid a:hover { color: var(--white); }
    .foot-bottom {
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem;
      border-top: 1px solid var(--border); padding-top: 1.5rem; font-size: 0.85rem; color: var(--muted);
    }
    .to-top { background: none; border: 1px solid var(--border); color: var(--white); padding: 0.4rem 0.9rem; border-radius: 999px; cursor: pointer; font-family: inherit; font-size: 0.85rem; }

    /* Reveal animation */
    .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal.visible { opacity: 1; transform: none; }

    /* Responsive */
    @media (max-width: 1024px) {
      .cards-3, .why-grid, .projects-grid, .know-grid { grid-template-columns: repeat(2, 1fr); }
      .hero-grid, .about-grid, .contact-grid { grid-template-columns: 1fr; }
      .hero { min-height: auto; }
    }
    @media (max-width: 680px) {
      .cards-3, .why-grid, .projects-grid, .know-grid, .cert-grid, .row-2 { grid-template-columns: 1fr; }
      .stats { grid-template-columns: 1fr 1fr; }
      .foot-grid { grid-template-columns: 1fr; }
      .float-icon { display: none; }
      .dash { padding: 1rem; }
      .metrics { grid-template-columns: 1fr 1fr 1fr; }
      .job { padding: 1.4rem; }
      form { padding: 1.4rem; }
    }
    @media (max-width: 380px) {
      .stats { grid-template-columns: 1fr; }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important; animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important; scroll-behavior: auto !important;
      }
      .reveal { opacity: 1; transform: none; }
    }
